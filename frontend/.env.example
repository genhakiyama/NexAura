# Usually nothing is needed here.
#
# The Vercel deployment serves the API from the same domain (Vercel Services),
# and local development uses the Vite proxy in vite.config.js. Leave both
# variables empty in that setup.

# Only set this when the HTTP API is hosted on a different origin.
# VITE_API_URL=https://your-api.example.com

# Only set this when a real Socket.IO server (not Vercel Functions) is
# available. Without it, the deployed app syncs messages by polling.
# VITE_SOCKET_URL=https://your-api.example.com
