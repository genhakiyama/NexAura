# Production (Vercel) only: absolute URL of the Render backend, no trailing slash.
# Leave empty for local development; Vite proxies /auth, /chat and /socket.io.
VITE_API_URL=https://your-service.onrender.com

# Optional: only if Socket.IO lives on a different origin than the HTTP API.
# VITE_SOCKET_URL=https://your-service.onrender.com
