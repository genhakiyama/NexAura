{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/auth/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/chat/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "comment": "Socket.IO handshake and long-polling. Without this the catch-all below sends /socket.io to the frontend service, which answers with index.html and the client reports a network error.",
      "source": "/socket.io/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "comment": "Bare /socket.io (no trailing slash) also has to reach the backend.",
      "source": "/socket.io",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
