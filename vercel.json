{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/backend/index.js"
    },
    {
      "src": "/auth(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/chat/conversation(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/chat/message(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/friends(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/users(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/feed(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/ws(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/uploads(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/socket.io(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|json|txt|js|css))$",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ],
  "crons": [
    {
      "path": "/auth/cron/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}