{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/backend/index.js"
    },
    {
      "src": "/auth(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/chat(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/friends(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/users(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/feed(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/ws(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/uploads(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/socket.io(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}